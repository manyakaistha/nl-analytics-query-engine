# Server only. Set the real key in Render's Environment settings, never in Git.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
DEMO_MODE=true
APP_ENV=development
LOG_LEVEL=info
PORT=8000
CLIENT_REQUESTS_PER_MINUTE=5
GLOBAL_REQUESTS_PER_MINUTE=30
MAX_CONCURRENT_REQUESTS=2
LLM_DAILY_REQUEST_BUDGET=200
MAX_SELF_CORRECT_ATTEMPTS=2
GROQ_TIMEOUT_SECONDS=20
SQL_TIMEOUT_SECONDS=3
MAX_RESULT_ROWS=200
DUCKDB_MEMORY_MB=192
# Leave blank unless you know your ingress proxy's actual IP/CIDR.
# Wildcard trust is prohibited. Forwarded headers from other peers are ignored.
TRUSTED_PROXY_IPS=
